# ===== 服务 =====
PORT=3777
# 登录密码（必填，生产环境务必改掉）
ADMIN_PASSWORD=change-me

# ===== GitHub 内容仓（生产模式必填，DEV_MODE=1 时可留空）=====
GITHUB_TOKEN=
# 仓库归属与名称，例如 Nyaecho/blog-content
GITHUB_OWNER=
GITHUB_REPO=
# 推送分支
GITHUB_BRANCH=main

# ===== 站点时区 =====
# 需与博客 site.yaml 的 timeZone 一致；published 字段按此时区取日历日期
SITE_TIMEZONE=Asia/Shanghai

# ===== 动态地点自动定位（逆地理编码）=====
# nominatim：免费无需 key（默认）；国内服务器直连可能不稳，可改用 amap
# amap：高德 Web 服务 API，国内可靠，需到 lbs.amap.com 免费申请 key 并填入 AMAP_KEY
GEOCODE_PROVIDER=nominatim
AMAP_KEY=

# ===== 提交署名（可选，默认使用 shirone-admin）=====
COMMIT_AUTHOR_NAME=shirone-admin
COMMIT_AUTHOR_EMAIL=admin@example.com

# ===== DEV 模式（本地验证用）=====
# 置 1 后：读操作读本地文件；写操作不推送，改为浏览器下载 .md / .zip
DEV_MODE=0
# 本地内容仓路径（DEV_MODE=1 时必填）
DEV_CONTENT_DIR=
