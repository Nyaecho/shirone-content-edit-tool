# ===== 服务 =====
PORT=3777
# 监听地址（默认 127.0.0.1 仅本地：公网访问一律经同机 nginx 反代，不暴露端口）
# 需要局域网直连时改为 0.0.0.0（不推荐在公网服务器上这么做）
HOST=127.0.0.1
# 登录密码（必填，生产环境务必改掉）
ADMIN_PASSWORD=change-me

# ===== GitHub 内容仓（生产模式必填，DEV_MODE=1 时可留空）=====
GITHUB_TOKEN=
# 仓库归属与名称，例如 Nyaecho/blog-content
GITHUB_OWNER=
GITHUB_REPO=
# 推送分支
GITHUB_BRANCH=main

# ===== 站点时区 =====
# 需与博客 site.yaml 的 timeZone 一致；published 字段按此时区取日历日期
SITE_TIMEZONE=Asia/Shanghai

# ===== 动态地点自动定位（逆地理编码）=====
# nominatim：免费无需 key（默认）；国内服务器直连可能不稳，可改用 amap
# amap：高德 Web 服务 API，国内可靠，需到 lbs.amap.com 免费申请 key 并填入 AMAP_KEY
GEOCODE_PROVIDER=nominatim
AMAP_KEY=

# ===== 提交署名（可选，默认使用 shirone-admin）=====
COMMIT_AUTHOR_NAME=shirone-admin
COMMIT_AUTHOR_EMAIL=admin@example.com

# ===== 本地镜像（生产模式）=====
# 仓库副本的磁盘缓存目录；读操作优先走镜像，右上角 GitHub 按钮手动触发同步，启动时也会自动预热。
MIRROR_DIR=./.mirror

# ===== 博客健康数据页（可选；不配置则 /api/health/* 返回 503）=====
# mihealth 数据库路径（本工具自动建库/同步/清理，全自动无需 cron）
MIHEALTH_DB=
# 步数/睡眠默认统计天数（1~30；页面可用 ?days= 覆盖）
MIHEALTH_DAYS=7
# 快照内存缓存毫秒（默认 10 分钟）
MIHEALTH_CACHE_TTL_MS=600000
# 自动同步间隔毫秒（默认 1 小时，进程内定时器）
MIHEALTH_SYNC_INTERVAL_MS=3600000

# ===== 草稿暂存区 =====
# 勾选“草稿”的内容不推 GitHub，只存服务器此目录；取消草稿后保存即自动发布并搬运图片。
DRAFTS_DIR=./.drafts

# ===== 自动部署（可选；不配置则禁用部署 hook）=====
# webhook HMAC 密钥，与主题仓 Secret DEPLOY_HOOK_SECRET 保持一致
DEPLOY_SECRET=
# 服务器上 blog 仓库路径（稀疏检出 dist 的克隆，nginx root 指向 <DEPLOY_DIR>/dist）
DEPLOY_DIR=/www/wwwroot/blog
# 构建产物分支名（Actions 把 dist 以 orphan commit 强推到该分支）
DEPLOY_BRANCH=deploy

# ===== DEV 模式（本地验证用）=====
# 置 1 后：读操作读本地文件；写操作不推送，改为浏览器下载 .md / .zip
DEV_MODE=0
# 本地内容仓路径（DEV_MODE=1 时必填）
DEV_CONTENT_DIR=
